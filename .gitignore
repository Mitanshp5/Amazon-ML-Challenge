# Datasets are huge (~2.5 GB of TSVs) — never push to GitHub.
# Keep code, docs, plans, and small utils; data stays local.
*.tsv
**/dataset/
**/output/
**/output-local/
**/output-a100/
**/checkpoints/
**/models/
# Local sync state (never commit)
sync_manifest.json
# Competitor research notes (local only, never push)
RESEARCH_FINDINGS.md
*.DS_Store
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/
*.parquet
*.pkl
*.bin
*.joblib

# Added during audit/E00
graphify-out/
.opencode/
tmp/
splits/*
!splits/f05-v1/
splits/f05-v1/*
!splits/f05-v1/parallel-v1/
.pytest_cache/
cache/

# Allow parallel distribution bundle files (< 32 MB each) to sync seamlessly via GitHub
!runs/parallel-v1/**
!runs/parallel-v1/**/*.joblib
!runs/parallel-v1/**/*.parquet
